# Enforce LF line endings for all text files in the repo.
# This prevents the "LF will be replaced by CRLF" warnings and keeps
# git diff --stat -w counts accurate (no whitespace-only line-ending noise).
* text=auto eol=lf

# Explicitly binary — never mangle these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
